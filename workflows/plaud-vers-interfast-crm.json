      "id": "a21936f7-a6bc-43a8-8ffa-e608b59176e6",
      "name": "Normaliser la liste",
      "parameters": {
        "jsCode": "const DATE_MIN = '2026-10-07';\nconst out = [];\nconst seen = {};\nfunction parseLoose(s) {\n  const a = s.indexOf('{'); const b = s.lastIndexOf('}');\n  if (a === -1 || b === -1 || b <= a) return null;\n  try { return JSON.parse(s.slice(a, b + 1)); } catch (e) { return null; }\n}\nfunction collect(v) {\n  if (v === null || v === undefined) return;\n  if (typeof v === 'string') { const p = parseLoose(v); if (p) collect(p); return; }\n  if (Array.isArray(v)) { v.forEach(collect); return; }\n  if (typeof v === 'object') {\n    if (typeof v.id === 'string' && v.id.startsWith('of_') && !seen[v.id]) { seen[v.id] = true; out.push(v); return; }\n    Object.values(v).forEach(collect);\n  }\n}\nfor (const item of $input.all()) collect(item.json);\nreturn out\n  .filter(f => (Number(f.duration) || 0) >= 4000)\n  .filter(f => String(f.start_at || f.created_at || '').slice(0, 10) >= DATE_MIN)\n  .map(f => ({ json: {\n    file_id: f.id,\n    nom: f.name || '',\n    start_at: f.start_at || f.created_at || '',\n    duration_ms: Number(f.duration) || 0\n  } }));"
