    {
      "id": "8376bf3e-0095-4fa8-8d14-0a49a19ef3ba",
      "name": "Transcript",
      "parameters": {
        "jsCode": "const meta = $('Boucle').item.json;\nconst raw = $input.item.json;\nfunction parseLoose(s) {\n  if (typeof s !== 'string') return null;\n  const a = s.indexOf('{'); const b = s.lastIndexOf('}');\n  const c = s.indexOf('['); const d = s.lastIndexOf(']');\n  let start = a, end = b;\n  if (c !== -1 && (a === -1 || c < a)) { start = c; end = d; }\n  if (start === -1 || end === -1 || end <= start) return null;\n  try { return JSON.parse(s.slice(start, end + 1)); } catch (e) { return null; }\n}\nfunction find(v) {\n  if (v === null || v === undefined) return null;\n  if (typeof v === 'string') { const p = parseLoose(v); return p ? find(p) : null; }\n  if (Array.isArray(v)) { for (const x of v) { const r = find(x); if (r) return r; } return null; }\n  if (typeof v === 'object') {\n    if (Array.isArray(v.source_list)) return v;\n    for (const x of Object.values(v)) { const r = find(x); if (r) return r; }\n  }\n  return null;\n}\nconst file = find(raw) || {};\nconst sources = Array.isArray(file.source_list) ? file.source_list : [];\nconst byType = {};\nfor (const s of sources) {\n  const segs = Array.isArray(s.data_content) ? s.data_content : (parseLoose(s.data_content) || []);\n  if (Array.isArray(segs) && segs.length) byType[String(s.data_type || '')] = segs;\n}\nconst chosen = byType['transaction_polish'] || byType['transaction'] || Object.values(byType)[0] || [];\nconst lines = chosen\n  .map(s => ((s.speaker || 'Interlocuteur') + ': ' + (s.content || s.text || '')).trim())\n  .filter(l => l.length > 3);\nconst text = lines.join('\\n');\nconst start = DateTime.fromISO(meta.start_at, { zone: 'utc' });\nconst startLocal = start.isValid ? start.setZone('Europe/Paris') : null;\nconst ageH = start.isValid ? DateTime.now().diff(start, 'hours').hours : 0;\nconst ready = text.length > 40;\nlet action = 'classer';\nif (!ready) action = ageH > 48 ? 'abandonner' : 'attendre';\nreturn { json: {\n  file_id: meta.file_id,\n  nom: meta.nom,\n  debut: startLocal ? startLocal.toFormat('dd/MM/yyyy HH:mm') : '',\n  duree_min: Math.round((meta.duration_ms || 0) / 60000),\n  age_heures: Math.round(ageH),\n  action,\n  transcript: text.slice(0, 60000),\n  nb_segments: chosen.length,\n  types_dispo: Object.keys(byType).join(',')\n} };",
        "mode": "runOnceForEachItem"
      },
      "position": [
        1568,
        400
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
