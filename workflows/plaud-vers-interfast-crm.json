    {
      "id": "b2648d12-a762-4115-a6b3-993167523d05",
      "name": "Evaluer la correspondance",
      "parameters": {
        "jsCode": "const cls = $('Classer').item.json.output || {};\nconst res = $input.item.json || {};\nconst all = Array.isArray(res.items) ? res.items : [];\nconst items = all.filter(c => String(c.reference || '').toUpperCase().startsWith('C') && String(c.category || 'client') !== 'supplier');\nconst norm = s => (s || '').toString().replace(/\\D/g, '');\nconst phone = norm(cls.client_tel);\nconst ville = (cls.client_ville || '').toString().toLowerCase();\nconst nomCherche = (cls.client_nom || '').toString().trim();\nlet cands = nomCherche ? items : [];\nif (cands.length > 1 && phone.length >= 9) {\n  const p = cands.filter(c => norm(c.phoneNumber).endsWith(phone.slice(-9)) || norm(c.secondaryPhoneNumber).endsWith(phone.slice(-9)));\n  if (p.length) cands = p;\n}\nif (cands.length > 1 && ville) {\n  const v = cands.filter(c => (((c.address || {}).city) || '').toLowerCase().includes(ville));\n  if (v.length) cands = v;\n}\nconst match = cands.length === 1 ? cands[0] : null;\nreturn { json: {\n  match: !!match,\n  client_id: match ? String(match.id) : '',\n  client_nom: match ? (match.name || '').trim() : '',\n  nb_resultats: nomCherche ? items.length : 0,\n  candidats: nomCherche ? items.map(c => (c.name || '').trim() + ' (' + c.reference + ')').join(', ') : 'nom du client non identifie dans la conversation'\n} };",
        "mode": "runOnceForEachItem"
      },
      "position": [
        3008,
        208
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
