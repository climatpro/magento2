    {
      "id": "53e0b1d3-785f-4908-a215-79a22d6355d6",
      "name": "Extraire codes",
      "parameters": {
        "jsCode": "const h = String($input.first().json.html || '');\nconst dec = s => String(s || '').replace(/<br\\s*\\/?>/gi, ' ').replace(/<[^>]+>/g, ' ').replace(/&#0?39;|&rsquo;|&#8217;/g, \"'\").replace(/&amp;/g, '&').replace(/&quot;/g, '\"').replace(/&nbsp;/g, ' ').replace(/&#8211;|&#8212;/g, '-').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/\\s+/g, ' ').trim();\nconst parts = h.split('class=\"wrapper-resultat-code\"').slice(1);\nconst jour = $now.setZone('Europe/Paris').toISODate();\nconst out = [];\nconst vus = new Set();\nfor (const p of parts) {\n  const c = /code=\"([^\"]*)\"/.exec(p);\n  if (!c) continue;\n  const code = dec(c[1]);\n  const des = /class=\"designation-code\">([\\s\\S]*?)<\\/div>/.exec(p);\n  const not = /class=\"note-code\">([\\s\\S]*?)<\\/div>/.exec(p);\n  const designation = des ? dec(des[1].replace(/<h4>[\\s\\S]*?<\\/h4>/, '')) : '';\n  const notes = not ? dec(not[1].replace(/<h4>[\\s\\S]*?<\\/h4>/, '')) : '';\n  const code_cle = code.toUpperCase().replace(/[^A-Z0-9]/g, '');\n  if (!code_cle || vus.has(code_cle)) continue;\n  vus.add(code_cle);\n  out.push({ json: { marque: 'Toshiba', code, code_cle, designation, notes, source: 'espacepro.toshiba-confort.fr/codes-defauts', maj: jour } });\n}\nif (out.length < 100) throw new Error('Seulement ' + out.length + ' codes lus : la page Toshiba a peut-etre change, import annule.');\nreturn out;",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      },
