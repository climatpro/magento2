    {
      "id": "c3db9e56-3c75-4fb0-90e7-3c1a959be754",
      "name": "Comprendre",
      "parameters": {
        "jsCode": "// Comprend la demande de Laurent : bouton sous une note a valider, ou reponse a une note (nom ou id Interfast).\n// Seuls les admins de bot_users sont ecoutes. Tout le reste est ignore.\nconst u = ($('Entree').first().json || {}).update || {};\nconst admins = $input.all().map(i => i.json).filter(r => r && String(r.role || '') === 'admin' && r.actif !== false).map(r => String(r.telegram_id).trim());\nconst cb = u.callback_query;\nif (cb) {\n  if (!admins.includes(String((cb.from || {}).id))) return [];\n  const p = String(cb.data || '').split(':');\n  if (p[0] !== 'nv' || !/^\\d+$/.test(p[1] || '')) return [];\n  const msg = cb.message || {};\n  return [{ json: { source: 'bouton', note_id: Number(p[1]), tg_id: -1, action: p[2] === 'ok' ? 'ok' : 'no', saisie: '', cb_id: cb.id, chat_id: String((msg.chat || {}).id || ''), msg_id: msg.message_id || 0, note_msg_id: msg.message_id || 0, texte_origine: msg.text || '' } }];\n}\nconst m = u.message || {};\nif (((m.chat || {}).type === 'private') && admins.includes(String((m.from || {}).id)) && m.reply_to_message) {\n  const t = String(m.text || '').trim();\n  if (!t) return [];\n  const estId = /^\\d{3,10}$/.test(t);\n  return [{ json: { source: 'reponse', note_id: -1, tg_id: m.reply_to_message.message_id, action: estId ? 'id' : 'nom', saisie: t.slice(0, 80), cb_id: '', chat_id: String(m.chat.id), msg_id: m.message_id, note_msg_id: m.reply_to_message.message_id, texte_origine: m.reply_to_message.text || '' } }];\n}\nreturn [];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      },
      "position": [
        440,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "823b41fd-a811-4ce5-b4b6-5d380624aa4e",
      "name": "Decider",
      "parameters": {
        "jsCode": "// Decide quoi faire de la note validee par Laurent. Production : toutes les fiches clients sont autorisees.\n// Reponse a une note deja ignoree = motif (sert a affiner les consignes).\nconst MODE_TEST = false;\nconst AUTORISES = ['406157', '405318'];\nconst VIDES = ['client', 'clients', 'cliente', 'chez', 'monsieur', 'madame', 'mr', 'mme', 'la', 'le', 'les', 'de', 'du', 'des', 'et', 'sarl', 'sas', 'sci', 'societe', 'famille', 'villa', 'residence'];\nconst c = $('Comprendre').first().json;\nconst note = ($('Lire la note').first() || {}).json || {};\nconst res = $input.first().json || {};\nconst norm = s => String(s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();\nconst out = { ...c, note_id: note.id || null, contenu: note.contenu || '', ecrire: false, client_id: '', client_nom: '', statut: '', motif: '', final: false, reponse: '' };\nif (!note.id) { out.reponse = 'Note introuvable.'; return [{ json: out }]; }\nif (note.statut === 'ignoree' && c.source === 'reponse') { out.statut = 'ignoree'; out.motif = c.saisie; out.reponse = 'Motif note : ' + c.saisie + '. Merci, ca servira a affiner les consignes.'; return [{ json: out }]; }\nif (note.statut !== 'a_valider') { out.reponse = 'Cette note est deja traitee (' + note.statut + ').'; return [{ json: out }]; }\nif (c.action === 'no') { out.statut = 'ignoree'; out.final = true; out.reponse = 'Note ignoree. Pourquoi ? Reponds a ce message d un mot si tu veux (facultatif).'; }\nelse if (c.action === 'ok') {\n  if (note.client_id) { out.ecrire = true; out.client_id = String(note.client_id); out.client_nom = note.client_nom || ''; }\n  else out.reponse = 'Pas de client propose : reponds a ce message avec le nom du client ou son id Interfast.';\n}\nelse if (c.action === 'id') { out.ecrire = true; out.client_id = c.saisie; out.client_nom = 'id ' + c.saisie; }\nelse if (c.action === 'nom') {\n  const mots = norm(c.saisie).split(' ').filter(w => w.length > 1 && !VIDES.includes(w));\n  let items = (Array.isArray(res.items) ? res.items : []).filter(x => String(x.reference || '').toUpperCase().startsWith('C') && String(x.category || 'client') !== 'supplier');\n  const tous = items;\n  items = mots.length ? items.filter(x => mots.every(w => norm(x.name).split(' ').some(m => m === w || (w.length >= 4 && m.startsWith(w))))) : [];\n  const liste = l => l.slice(0, 6).map(x => '- ' + String(x.name || '').trim() + ' (' + x.reference + ') : id ' + x.id).join('\\n');\n  if (items.length === 1) { out.ecrire = true; out.client_id = String(items[0].id); out.client_nom = String(items[0].name || '').trim(); }\n  else if (items.length > 1) out.reponse = 'Plusieurs fiches correspondent :\\n' + liste(items) + '\\nReponds a la note avec le bon id.';\n  else out.reponse = 'Aucune fiche trouvee pour \"' + c.saisie + '\".' + (tous.length ? '\\nFiches proches :\\n' + liste(tous) + '\\nReponds a la note avec le bon id.' : ' Essaie un autre nom ou l id Interfast.');\n}\nif (out.ecrire && MODE_TEST && !AUTORISES.includes(out.client_id)) {\n  out.ecrire = false;\n  out.reponse = 'Mode test : rien ecrit sur ' + (out.client_nom || out.client_id) + '. La note reste a valider.';\n}\nreturn [{ json: out }];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      },
