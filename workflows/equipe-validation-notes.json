    {
      "id": "2d1170de-7fe7-4a46-8c5d-8c83b36f9933",
      "name": "Apres ecriture",
      "parameters": {
        "jsCode": "// Resultat de l'ecriture dans Interfast.\nconst d = $('Decider').first().json;\nconst r = $input.first().json || {};\nconst ok = !r.error && !(r.statusCode && r.statusCode >= 400);\nreturn [{ json: { ...d, statut: ok ? 'envoyee' : '', final: ok, reponse: ok ? 'Note ajoutee sur la fiche ' + (d.client_nom || d.client_id) + '.' : 'Echec Interfast (' + String((r.error && (r.error.message || r.error)) || r.statusCode || '?').slice(0, 120) + '). La note reste a valider.' } }];",
