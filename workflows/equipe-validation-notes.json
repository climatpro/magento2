        "jsCode": "// Reponse a renvoyer a Laurent (une seule, quelle que soit la branche).\nlet d = null;\ntry { d = $('Apres ecriture').first().json; } catch (e) { d = null; }\nif (!d) d = $('Decider').first().json;\nconst esc = s => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst icone = d.statut === 'envoyee' ? '✅ ' : (d.statut === 'ignoree' ? '🗑 ' : 'ℹ️ ');\nconst nouveauTexte = esc(String(d.texte_origine || '').slice(0, 3200)) + '\\n\\n<b>' + icone + esc(d.reponse) + '</b>';\nreturn [{ json: { ...d, alerte: (icone + d.reponse).slice(0, 190), nouveau_texte: nouveauTexte, reponse_html: icone + esc(d.reponse) } }];",
