    {
      "id": "79784d31-2243-440a-87f7-5a05c53d2f31",
      "name": "Preparer message",
      "parameters": {
        "jsCode": "// Groupe Telegram ClimatPro Equipe : bot muet, il ne repond jamais. Il range chaque message.\n// Ignore : conversations privees, messages de service (arrivee, depart, titre, epingle).\nconst upd = $('Message du groupe').first().json;\nconst m = upd.message || {};\nconst chat = m.chat || {};\nif (!['group', 'supergroup'].includes(chat.type)) return [];\nif (m.new_chat_members || m.left_chat_member || m.group_chat_created || m.supergroup_chat_created || m.new_chat_title || m.new_chat_photo || m.pinned_message || m.migrate_to_chat_id || m.migrate_from_chat_id) return [];\nconst users = $input.all().map(i => i.json).filter(r => r && r.telegram_id);\nconst from = m.from || {};\nconst connu = users.find(r => String(r.telegram_id).trim() === String(from.id));\nconst auteur = connu ? connu.nom : ([from.first_name, from.last_name].filter(Boolean).join(' ') || 'Inconnu');\nlet type = 'texte', fileId = '';\nif (Array.isArray(m.photo) && m.photo.length) { type = 'photo'; fileId = m.photo[m.photo.length - 1].file_id; }\nelse if (m.document) { const im = String(m.document.mime_type || '').startsWith('image/'); type = im ? 'photo' : 'document'; if (im) fileId = m.document.file_id; }\nelse if (m.voice || m.audio) type = 'vocal';\nelse if (m.video || m.video_note) type = 'video';\nelse if (m.sticker) type = 'sticker';\nelse if (m.location) type = 'position';\nelse if (m.contact) type = 'contact';\nlet texte = m.text || m.caption || '';\nif (m.location) texte = (texte ? texte + ' ' : '') + 'https://maps.google.com/?q=' + m.location.latitude + ',' + m.location.longitude;\nif (m.contact) texte = (texte ? texte + ' ' : '') + [m.contact.first_name, m.contact.last_name].filter(Boolean).join(' ') + ' ' + (m.contact.phone_number || '');\nif (m.document && type === 'document') texte = (texte ? texte + ' ' : '') + '[fichier : ' + (m.document.file_name || 'document') + ']';\nconst d = DateTime.fromSeconds(Number(m.date || 0)).setZone('Europe/Paris');\nconst nomFichier = d.toFormat('yyyy-LL-dd_HH-mm') + '_' + String(auteur).replace(/[^A-Za-z0-9]+/g, '-') + '_' + m.message_id + '.jpg';\nreturn [{ json: { chat_id: String(chat.id), tg_message_id: m.message_id, telegram_id: String(from.id || ''), auteur, texte: String(texte).slice(0, 4000), type, file_id: fileId, date: d.toUTC().toISO(), nom_fichier: nomFichier } }];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      },
