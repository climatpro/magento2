    {
      "id": "f98d471d-31ed-463d-9cb4-d77870c80ab6",
      "name": "Comparer",
      "notes": "Garde les images nouvelles ou modifiees (md5 different de la table). Aucune sortie = rien a faire.",
      "parameters": {
        "jsCode": "// Images de Drive a envoyer dans WordPress : nouvelles, ou dont le contenu (md5) a change.\n// Les images du sous-dossier icones sont rangees dans la table sous la cle \"icones/<mot>.png\".\nconst ICONES = '1uIhYG4xxOMhXr9gCGLnoYrdfGSbV22FU';\nconst files = (($('Lister images Drive').first().json || {}).files) || [];\nconst rows = $('Lire table images').all().map(i => i.json).filter(r => r && r.nom);\nconst parNom = {};\nfor (const r of rows) parNom[r.nom] = r;\nconst out = [];\nfor (const f of files) {\n  if (!/\\.(png|jpe?g|gif|webp|svg)$/i.test(f.name || '')) continue;\n  const icone = (f.parents || []).includes(ICONES);\n  const cle = (icone ? 'icones/' : '') + f.name;\n  const r = parNom[cle];\n  if (r && r.url && r.md5 === (f.md5Checksum || '')) continue;\n  out.push({ json: { id: f.id, name: cle, fichier: (icone ? 'icone-' : '') + f.name, mimeType: f.mimeType, md5: f.md5Checksum || '', oldWpId: r && r.wp_id ? Number(r.wp_id) : null } });\n}\nreturn out;"
      },
      "position": [
        896,
        96
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
