      "name": "Compute MD5",
      "parameters": {
        "jsCode": "// Récupère le vrai buffer binaire via l'API N8N (compatible filesystem-v2)\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\n\n// Hash 53 bits pure JS (cyrb53), aucune dependance crypto\nlet h1 = 0xdeadbeef, h2 = 0x41c6ce57;\nfor (let i = 0; i < buffer.length; i++) {\n  h1 = Math.imul(h1 ^ buffer[i], 2654435761);\n  h2 = Math.imul(h2 ^ buffer[i], 1597334677);\n}\nh1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507) ^ Math.imul(h2 ^ (h2 >>> 13), 3266489909);\nh2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507) ^ Math.imul(h1 ^ (h1 >>> 13), 3266489909);\nconst md5 = (4294967296 * (2097151 & h2) + (h1 >>> 0)).toString(16).padStart(14, '0');\n\n// Base64 réel pour le body HTTP de Gemini en aval\nconst pdfBase64 = buffer.toString('base64');\n\nconst binaryMeta = items[0].binary && items[0].binary.data;\nconst filename = items[0].json.name || (binaryMeta && binaryMeta.fileName) || '';\nconst m = filename.match(/^(\\d{4})(\\d{2})(\\d{2})(\\d{2})(\\d{2})(\\d{2})/);\nconst scanDate = m ? `${m[1]}-${m[2]}-${m[3]}` : null;\n\nreturn [{\n  json: {\n    ...items[0].json,\n    md5,\n    scanDate,\n    originalFilename: filename,\n    sourceFileId: items[0].json.id,\n    sourceParentId: (items[0].json.parents && items[0].json.parents[0]) || '1RiEj8rvkgx9GR-ULdvvnrwL1lMYvUO0d',\n    pdfBase64\n  },\n  binary: items[0].binary\n}];"
