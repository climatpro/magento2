    {
      "id": "23b84b1e-5bcc-4123-a194-86d4c17db3a6",
      "name": "Parse Gemini Response",
      "parameters": {
        "jsCode": "const geminiText = items[0].json.candidates[0].content.parts[0].text;\nconst data = JSON.parse(geminiText);\n\nconst prev = $('Compute MD5').first().json;\n\nconst inputDate = data.doc_date || prev.scanDate;\nconst date = new Date(inputDate);\nif (isNaN(date.getTime())) {\n  throw new Error('Date invalide retournee par Gemini : ' + inputDate);\n}\n\nconst yyyy = date.getFullYear();\nconst mm = String(date.getMonth() + 1).padStart(2, '0');\nconst dd = String(date.getDate()).padStart(2, '0');\n\nconst moisFr = ['janvier','fevrier','mars','avril','mai','juin','juillet','aout','septembre','octobre','novembre','decembre'];\nconst targetFolderName = 'depenses ' + moisFr[date.getMonth()] + ' ' + yyyy;\n\nconst slugify = (s) => (s || '')\n  .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n  .replace(/[^a-zA-Z0-9 \\-]/g, '')\n  .trim()\n  .replace(/\\s+/g, '-')\n  .substring(0, 40);\n\nconst emitterSlug = slugify(data.emitter || 'INCONNU').toUpperCase();\nconst objectSlug = slugify(data.object || 'document').toLowerCase();\nlet newFilename = yyyy + mm + dd + '_' + emitterSlug + '_' + objectSlug;\nif (data.amount_ttc != null) {\n  newFilename += '_' + data.amount_ttc.toFixed(2) + 'EUR';\n}\nnewFilename += '.pdf';\n\nconst libelle = (data.emitter || 'Inconnu') + ' - ' + (data.object || 'document');\nconst dateFr = dd + '/' + mm + '/' + yyyy;\n\nreturn [{\n  json: {\n    ...prev,\n    gemini: data,\n    targetFolderName,\n    subtypeFolderName: data.subtype,\n    newFilename,\n    libelle: libelle.substring(0, 100),\n    dateFr\n  },\n  binary: items[0].binary\n}];"
      },
      "position": [
        -1168,
        160
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
