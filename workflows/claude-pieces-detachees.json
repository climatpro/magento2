      "name": "Entree",
      "parameters": {
        "jsCode": "const i = $input.first().json || {};\nconst h = i.headers || {};\nconst b = (i.body && Object.keys(i.body).length) ? i.body : (i.query || {});\nif (String(h['x-cle'] || '') !== '<SECRET-RETIRE>') return [{ json: { marque: 'erreur', erreur: 'cle webhook invalide' } }];\nconst marque = String(b.marque || '').toLowerCase().trim();\nconst reference = String(b.reference || '').trim();\nconst modele = String(b.modele || '').trim();\nconst mots_cles = String(b.mots_cles || '').trim();\nif (!['toshiba', 'hitachi'].includes(marque)) return [{ json: { marque: 'erreur', erreur: 'marque attendue : toshiba ou hitachi' } }];\nif (!reference && !modele) return [{ json: { marque: 'erreur', erreur: 'fournir une reference de piece, ou un modele + mots_cles' } }];\nreturn [{ json: { marque, reference, modele, mots_cles, erreur: '' } }];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
