      "name": "Preparer rappel",
      "parameters": {
        "jsCode": "// Rappel du soir : seulement s'il reste des notes a valider.\nconst rows = $input.all().map(i => i.json).filter(r => r && r.id);\nif (!rows.length) return [];\nconst esc = s => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst lignes = rows.slice(0, 15).map(r => '- ' + esc(r.client_nom || 'Client ?') + ' (' + esc(r.date_lot || '') + ')');\nlet t = '<b>⏳ ' + rows.length + ' note' + (rows.length > 1 ? 's' : '') + ' a valider</b>\\n' + lignes.join('\\n');\nif (rows.length > 15) t += '\\n... et ' + (rows.length - 15) + ' autres';\nt += '\\n\\n<i>Remonte dans cette conversation pour les traiter.</i>';\nreturn [{ json: { texte: t } }];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      },
