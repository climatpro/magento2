      "name": "Verifier lien",
      "parameters": {
        "jsCode": "// Lien « Valider » envoye a Laurent sur Telegram : verifie le jeton (usage unique).\nconst q = ($('Lien valider').first().json || {}).query || {};\nconst r = $input.all().map(i => i.json).find(x => x && x.message_id === String(q.m || '')) || {};\nconst ok = !!(r.jeton && String(q.t || '') === r.jeton && r.statut === 'doute' && /^D[CE]\\d{3,6}$/.test(String(r.reference || '')));\nreturn [{ json: { ok, reference: r.reference || '', message_id: r.message_id || '', date_mail: r.date_mail || new Date().toISOString() } }];\n"
