    {
      "executeOnce": true,
      "id": "5fde8bea-98bf-461d-9b5e-38cb8b7f5417",
      "name": "Nouveaux mails",
      "parameters": {
        "jsCode": "// Messages Gmail recents pas encore vus (table devis_mails). 25 max par passage.\nconst liste = (($('Gmail - liste').first() || {}).json || {}).messages || [];\nconst vus = new Set($('Lire mails traites').all().map(i => String((i.json || {}).message_id || '')).filter(Boolean));\nreturn liste.filter(m => m && m.id && !vus.has(m.id)).slice(0, 25).map(m => ({ json: { id: m.id } }));\n"
      },
