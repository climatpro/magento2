    {
      "id": "afba65b1-a8b4-4301-be7e-c6574713069b",
      "name": "Decider",
      "parameters": {
        "jsCode": "// Meme repartition que le workflow « Climapro - Devis signes a planifier ».\nconst CHRISTOPHE = /entretien|maintenance|contrat|d[ée]pannage|r[ée]paration|relevage|fuite|diagnostic|nettoyage|filtre|r[ée]vision|recharge|thermostat|compresseur|carte|moteur|ventilat|condensateur|sonde|vanne|pi[eè]ce/i;\nconst LAURENT = /install|\\bpose\\b|nouvel|split|multi|gainable|\\bvrv\\b|\\bvrf\\b|\\bdrv\\b|\\bpac\\b|pompe [àa] chaleur|climatisation|cassette|console|murale|yukai|haori|daikin|toshiba|mitsubishi|hitachi|fujitsu|haier|ballon|chauffe-eau|vmc|plancher|chaudi[eè]re/i;\nconst responsable = t => CHRISTOPHE.test(t) ? 'christophe' : (LAURENT.test(t) ? 'laurent' : 'christophe');\nconst ligne = (d, dateMail, msgId) => {\n  const c = d.client || {};\n  return { reference: String(d.reference).toUpperCase(), devis_id: String(d.id), titre: String(d.name || '').slice(0, 200),\n    client: String(c.name || '').trim(), client_id: String(c.id || ''), ville: String(d.addressCity || ''), telephone: String(c.phoneNumber || ''),\n    signe_le: dateMail, responsable: responsable(String(d.name || '')), planifie: false, planifie_le: null, intervention_ref: '',\n    vu_le: new Date().toISOString(), source: 'mail' };\n};\n\n// Decision par mail : ajouter (acceptation claire + devis trouve et pas encore accepte dans Interfast),\n// doute (a confirmer par Laurent via le lien Telegram), deja_signe, non (pas une acceptation).\nconst m = $('Lire reponse Haiku').item.json;\nconst res = $input.item.json || {};\nconst d = (Array.isArray(res.items) ? res.items : []).find(x => String(x.reference || '').toUpperCase() === m.reference) || null;\nconst st = d ? String(d.status || '') : '';\nlet decision = 'non';\nif (m.accepte) {\n  if (d && ['signed', 'paid'].includes(st)) decision = 'deja_signe';\n  else if (d && m.certain && ['sent', 'finalized', 'draft'].includes(st)) decision = 'ajouter';\n  else decision = 'doute';\n}\nconst jeton = decision === 'doute' ? Array.from({ length: 24 }, () => 'abcdefghijkmnpqrstuvwxyz23456789'[Math.floor(Math.random() * 32)]).join('') : '';\nconst esc = s => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nlet texte = '';\nif (decision === 'doute') {\n  texte = '<b>📩 Devis accepté par mail ?</b>\\n'\n    + (d ? '<b>' + esc(d.reference) + '</b> ' + esc(d.name) + ' · ' + esc((d.client || {}).name) + ' (statut Interfast : ' + esc(st) + ')\\n' : 'N° de devis non trouvé' + (m.reference ? ' (' + esc(m.reference) + ' ?)' : '') + '\\n')\n    + 'De : ' + esc(m.expediteur) + '\\nObjet : ' + esc(m.sujet) + '\\n\\n<blockquote expandable>' + esc(m.neuf.slice(0, 900)) + '</blockquote>\\n'\n    + '<i>' + esc(m.raison) + '</i>' + (d ? '' : '\\n\\nSans n° de devis, passe le bon devis en Accepté dans Interfast : il arrivera tout seul au tableau.');\n}\nreturn { json: {\n  decision, jeton, texte, avec_bouton: !!(d && decision === 'doute'),\n  lien: 'https://n8n.climatpro.fr/webhook/devis-mail-valider?m=' + encodeURIComponent(m.message_id) + '&t=' + jeton,\n  mail: { message_id: m.message_id, date_mail: m.date_mail, expediteur: m.expediteur, decision, reference: d ? String(d.reference) : m.reference, raison: m.raison, jeton, statut: decision === 'doute' ? 'doute' : 'fait' },\n  ligne: decision === 'ajouter' ? ligne(d, m.date_mail, m.message_id) : null\n} };\n",
        "mode": "runOnceForEachItem"
      },
