      "name": "Devis clos ?",
      "parameters": {
        "jsCode": "// Lignes « acceptees par mail » encore ouvertes : si le devis a ete annule, refuse ou solde dans Interfast, on les ferme.\n// (S'il passe en Accepte, le workflow « Devis signes a planifier » le reprend tout seul.)\nconst lignes = $('Lignes mail ouvertes').all().map(i => i.json);\nconst out = [];\n$input.all().forEach((it, i) => {\n  const r = lignes[i] || {};\n  const st = String((it.json || {}).status || '');\n  if (r.reference && ['canceled', 'refused', 'paid'].includes(st)) out.push({ json: { reference: r.reference, planifie: true, planifie_le: new Date().toISOString(), intervention_ref: 'devis ' + st } });\n});\nreturn out;\n"
