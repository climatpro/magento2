    {
      "id": "bd98a819-2ec2-4d24-a712-a746d7f5ea14",
      "name": "Lire reponse Haiku",
      "parameters": {
        "jsCode": "// Reponse de Haiku -> decision. Le devis cite est verifie juste apres dans Interfast.\nconst src = $('Candidat ?').item.json;\nlet t = '';\ntry { t = ($input.item.json.content || []).map(c => c.text || '').join('').trim(); } catch (e) {}\nlet o = null;\ntry { const a = t.indexOf('{'), b = t.lastIndexOf('}'); o = JSON.parse(t.slice(a, b + 1)); } catch (e) { o = null; }\no = o || { accepte: false, certain: false, reference: '', raison: 'reponse illisible' };\nlet ref = String(o.reference || '').toUpperCase().replace(/\\s/g, '');\nif (!/^D[CE]\\d{3,6}$/.test(ref)) ref = (src.refs || []).length === 1 ? src.refs[0] : '';\nreturn { json: { ...src, accepte: !!o.accepte, certain: !!o.certain, reference: ref, raison: String(o.raison || '').slice(0, 200) } };\n",
        "mode": "runOnceForEachItem"
      },
      "position": [
        1792,
        192
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
