        672,
        288
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "202d98f6-c18c-4a11-8394-631c3334a25d",
      "name": "Pre-filtre",
      "parameters": {
        "jsCode": "// Lit chaque mail, isole le nouveau texte (sans la partie citee) et garde seulement ceux qui parlent d'un devis\n// avec un mot d'accord. Les autres sont notes « hors_sujet » pour ne pas etre relus. Aucune IA ici.\nconst dec = s => { try { return Buffer.from(String(s || '').replace(/-/g, '+').replace(/_/g, '/'), 'base64').toString('utf8'); } catch (e) { return ''; } };\nconst html2txt = s => String(s || '').replace(/<br\\s*\\/?>/gi, '\\n').replace(/<\\/(p|div|tr|li)>/gi, '\\n').replace(/<blockquote[\\s\\S]*$/i, '').replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&#39;/g, \"'\").replace(/&quot;/g, '\"').replace(/[ \\t]+/g, ' ');\nfunction corps(p) {\n  let txt = '', html = '';\n  (function walk(x) {\n    if (!x) return;\n    if (x.mimeType === 'text/plain' && x.body && x.body.data && !txt) txt = dec(x.body.data);\n    if (x.mimeType === 'text/html' && x.body && x.body.data && !html) html = dec(x.body.data);\n    (x.parts || []).forEach(walk);\n  })(p);\n  return txt || html2txt(html);\n}\nconst out = [];\nfor (const it of $input.all()) {\n  const m = it.json || {};\n  if (!m.id || !m.payload) continue;\n  const h = {};\n  for (const x of (m.payload.headers || [])) h[String(x.name).toLowerCase()] = x.value;\n  const de = String(h.from || '');\n  const email = ((de.match(/<([^>]+)>/) || [])[1] || de).trim().toLowerCase();\n  const sujet = String(h.subject || '');\n  const tout = corps(m.payload);\n  const coupe = tout.search(/^\\s*(Le .{3,160}a [ée]crit ?:|On .{3,160}wrote:|-{2,}\\s*(Original|Message d.origine)|De ?: |From: |Envoy[ée] ?: )/mi);\n  let neuf = (coupe > 0 ? tout.slice(0, coupe) : tout).split('\\n').filter(l => !/^\\s*>/.test(l)).join('\\n').replace(/\\n{3,}/g, '\\n\\n').trim();\n  const refs = [...new Set(((sujet + '\\n' + neuf + '\\n' + tout).toUpperCase().match(/\\bD[CE]\\s?\\d{3,6}\\b/g) || []).map(r => r.replace(/\\s/g, '')))];\n  const interne = /climatpro\\.fr|inter-fast|klb\\.fr|no-?reply|noreply/i.test(email);\n  const parleDevis = /devis|\\bD[CE]\\s?\\d{3,}/i.test(sujet + ' ' + tout);\n  const accord = /accept|accord|valid|bon pour|ok pour|c.est ok|\\bok\\b|on (y )?va|allez-y|allez y|\\bgo\\b|lancer|on part|command|confirm|sign[ée]|feu vert|retenu|on prend|nous prenons/i.test(neuf);\n  out.push({ json: {\n    message_id: m.id, thread_id: m.threadId || '', date_mail: new Date(Number(m.internalDate) || Date.now()).toISOString(),\n    expediteur: email, sujet: sujet.slice(0, 200), neuf: neuf.slice(0, 3000), refs,\n    candidat: !interne && parleDevis && accord && neuf.length > 0\n  } });\n}\nreturn out;\n"
      },
      "position": [
        1120,
        288
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
