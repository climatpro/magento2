      "id": "bcea53ed-4f33-491f-96ed-c22ba33f8fc7",
      "name": "Choisir la destination",
      "parameters": {
        "jsCode": "// Range le dernier memo en attente (label pro-ou-perso) selon la reponse du menu iPhone\nconst b = $('POST /climapro-ranger').first().json.body || {};\nconst n = s => String(s || '').trim().toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\nconst ch = n(b.choix);\nconst choix = /equipe/.test(ch) ? 'equipe' : /laurent|pro/.test(ch) ? 'pro' : 'perso';\nconst tasks = (($input.first().json || {}).results) || [];\nconst t = tasks.filter(x => !x.checked).sort((a, z) => String(z.added_at || '').localeCompare(String(a.added_at || '')))[0];\nif (!t) return [{ json: { ok: false, message: 'Aucun mémo en attente de rangement.' } }];\nconst labels = (t.labels || []).filter(l => l !== 'pro-ou-perso');\nlet content = t.content;\nlet move = { project_id: '6hh423vGr88f287j' };\nlet dest = 'Perso';\nif (choix === 'equipe') {\n  if (labels.includes('commande')) { move = { section_id: '6hjM3Rw4RPRw474w' }; dest = 'Équipe ClimatPro / Commandes matériel'; if (!/^À commander : /.test(content)) content = 'À commander : ' + content; }\n  else { move = { project_id: '6hh423vw4vGgHFPw' }; dest = 'Équipe ClimatPro'; }\n} else if (choix === 'pro') { move = { section_id: '6hh4246PVq2H9Fp8' }; dest = 'Laurent ClimatPro'; }\nreturn [{ json: { ok: true, id: t.id, maj: { labels, content }, move, message: 'Rangé > ' + dest + '\\n' + content } }];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      },
