    {
      "id": "13036191-36c0-402d-adf5-9297bd9597f1",
      "name": "Preparer envois",
      "parameters": {
        "jsCode": "// Pour chaque mail portant le libelle Telegram : 1 message texte + 1 envoi par vraie piece jointe (les logos de signature sont ignores), puis bascule des libelles.\nconst chatId = String(($input.first() || {}).json.chat_id || '');\nif (!chatId) throw new Error('Groupe Telegram introuvable dans la table equipe_messages');\nconst mails = $('Mails libelle Telegram').all();\nconst esc = t => String(t || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst ko = s => { const m = String(s || '').match(/([\\d.,]+)\\s*(B|kB|KB|MB|GB)/i); if (!m) return 0; const n = parseFloat(m[1].replace(',', '.')); const u = m[2].toUpperCase(); return u === 'B' ? n / 1024 : u === 'KB' ? n : u === 'MB' ? n * 1024 : n * 1048576; };\n// Un seul envoi par conversation (le message le plus recent), libelles bascules sur tous.\nconst parFil = {};\nfor (const it of mails) { const j = it.json; const k = j.threadId || j.id; const d = Number(j.internalDate || 0); if (!parFil[k] || d > Number(parFil[k].json.internalDate || 0)) parFil[k] = it; }\nconst out = [];\nfor (const it of Object.values(parFil)) {\n  const j = it.json;\n  const de = (j.from && j.from.text) || j.From || '';\n  const objet = j.subject || j.Subject || '';\n  let corps = String(j.text || '').replace(/\\r/g, '').replace(/\\[\\]\\([^)]*\\)/g, '').replace(/\\n{3,}/g, '\\n\\n').trim();\n  const coupe = corps.search(/Conform[ée]ment au RGPD|Ce message et toutes les pi[eè]ces jointes|This e-?mail and any attachments/i);\n  if (coupe > 0) corps = corps.slice(0, coupe).trim();\n  if (corps.length > 2500) corps = corps.slice(0, 2500) + '\\n[...]';\n  const docs = []; const tropLourds = [];\n  for (const [cle, b] of Object.entries(it.binary || {})) {\n    const nom = b.fileName || cle; const mime = b.mimeType || ''; const taille = ko(b.fileSize);\n    const logo = mime.startsWith('image/') && (/^CID_|^image\\d*\\.|^Outlook-|^logo/i.test(nom) || (taille > 0 && taille < 40));\n    if (logo) continue;\n    if (taille > 45 * 1024) { tropLourds.push(nom); continue; }\n    docs.push({ cle, nom });\n  }\n  let html = '<b>Mail transfere</b>\\n<b>De :</b> ' + esc(de) + '\\n<b>Objet :</b> ' + esc(objet);\n  if (corps) html += '\\n\\n' + esc(corps);\n  if (docs.length) html += '\\n\\n' + docs.length + ' piece(s) jointe(s) ci-dessous.';\n  if (tropLourds.length) html += '\\n\\nTrop lourd pour Telegram, voir le mail : ' + esc(tropLourds.join(', '));\n  out.push({ json: { type: 'texte', chat_id: chatId, html: html.slice(0, 4000), texte_fil: ('Mail transfere - ' + objet).slice(0, 500) } });\n  for (const d of docs) out.push({ json: { type: 'doc', chat_id: chatId, nom: d.nom }, binary: { data: it.binary[d.cle] } });\n}\nfor (const it of mails) out.push({ json: { type: 'fin', messageId: it.json.id } });\nreturn out;",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      },
