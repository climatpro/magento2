    {
      "id": "cd1c9c7b-d41b-422b-9992-5612088d2c5e",
      "name": "Formater fiche",
      "parameters": {
        "jsCode": "const id = String($('Appel outil').first().json.client_id || '');\nfunction data(n) { try { const r = $(n).first().json; return (r && r.ok) ? r.data : null; } catch (e) { return null; } }\nconst c = data('Lire fiche');\nif (!c) return [{ json: { resultat: 'Client ' + id + ' introuvable.' } }];\nconst g = c.clientParticular || c.clientProfessional || c.clientOwnersAssociation || {};\nconst L = ['Client : ' + (c.displayName || g.name || [g.firstName, g.lastName].filter(Boolean).join(' ') || id) + ' (client_id ' + id + ')'];\nconst contacts = (g.contacts || []).slice();\nif (g.contact && !contacts.length) contacts.push(g.contact);\nfor (const ct of contacts.slice(0, 6)) {\n  const nom = [ct.civility, ct.firstName, ct.lastName].filter(Boolean).join(' ');\n  const info = [nom, ct.phoneNumber ? 'tel ' + ct.phoneNumber : '', ct.secondaryPhoneNumber ? 'tel2 ' + ct.secondaryPhoneNumber : '', ct.email ? 'mail ' + ct.email : '', (ct.roles || []).includes('primary') ? 'principal' : '', ct.comment ? 'note: ' + String(ct.comment).replace(/\\s+/g, ' ') : ''].filter(Boolean).join(' | ');\n  if (info) L.push('Contact : ' + info);\n}\nif (c.commentary) L.push('Note fiche : ' + String(c.commentary).replace(/\\s+/g, ' ').slice(0, 300));\nconst ad = data('Lire adresses');\nconst adresses = (ad && (ad.items || ad)) || [];\nif (Array.isArray(adresses)) for (const a of adresses.slice(0, 5)) {\n  L.push('Adresse : ' + [a.address, [a.zipCode, a.city].filter(Boolean).join(' '), a.additionalLine, a.comments].filter(Boolean).join(', ').replace(/\\s+/g, ' '));\n}\nconst ev = data('Lire historique');\nconst hist = ((ev && ev.items) || []).filter(e => e.start).sort((a, b) => String(b.start).localeCompare(String(a.start))).slice(0, 12);\nif (hist.length) {\n  L.push('Historique (plus recent en premier) :');\n  const NOMS = { 5066: 'Laurent', 5069: 'Christophe', 9965: 'Axel', 5198: 'Julien' };\n  for (const e of hist) {\n    const d = DateTime.fromISO(e.start, { zone: 'utc' }).setZone('Europe/Paris').toFormat('dd/MM/yyyy');\n    const t = [...new Set((e.technicianIds || (e.users || []).map(u => u.id)).map(x => NOMS[x] || x))].join('+');\n    L.push('- ' + d + ' | ' + [e.type, e.title && e.title !== e.type ? e.title : ''].filter(Boolean).join(' : ').replace(/\\s+/g, ' ').slice(0, 100) + (t ? ' | ' + t : '') + (e.finished ? ' | termine' : ''));\n  }\n}\nreturn [{ json: { resultat: L.join('\\n') } }];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      },
      "position": [
        896,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
