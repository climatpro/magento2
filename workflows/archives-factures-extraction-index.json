      "id": "6489b386-7cf9-4c33-a358-a18b5a5f1f89",
      "name": "Construire ligne",
      "parameters": {
        "jsCode": "const src = $('Boucle factures').item.json;\nconst j = $json || {};\nlet texte = '';\nif (typeof j.content === 'string') texte = j.content;\nelse if (Array.isArray(j.content)) texte = j.content.map(c => (c && c.text) || '').join('');\nelse if (typeof j.text === 'string') texte = j.text;\nelse if (typeof j.output === 'string') texte = j.output;\nelse texte = JSON.stringify(j);\nlet d = null;\nlet statut = 'ok';\ntry {\n  const t = texte.replace(/```json|```/g, '');\n  const a = t.indexOf('{');\n  const b = t.lastIndexOf('}');\n  d = JSON.parse(t.slice(a, b + 1));\n} catch (e) { statut = 'erreur_lecture'; d = {}; }\nif (statut === 'ok' && d.est_facture_climatpro === false) statut = 'pas_climatpro';\nconst num = v => (v === null || v === undefined || v === '' || isNaN(Number(v))) ? '' : Number(v);\nconst cpBrut = String(d.code_postal || '').replace(/\\D/g, '');\nconst cp = cpBrut ? \"'\" + cpBrut.padStart(5, '0') : '';\nreturn { json: {\n  numero: src.numero,\n  type_doc: d.type_doc || (src.numero.startsWith('AV') ? 'avoir' : 'facture'),\n  date_facture: d.date_facture || '',\n  date_intervention: d.date_intervention || '',\n  client: d.client || '',\n  dossier_client: src.dossier_client,\n  ville: d.ville || '',\n  code_postal: cp,\n  type_intervention: d.type_intervention || '',\n  marque: d.marque || '',\n  modele: d.modele || '',\n  puissance_kw: num(d.puissance_kw),\n  nb_unites_int: num(d.nb_unites_int),\n  description: String(d.description || '').slice(0, 400),\n  montant_ht: num(d.montant_ht),\n  montant_ttc: num(d.montant_ttc),\n  lien_pdf: src.lien_pdf,\n  file_id: src.file_id,\n  statut: statut,\n  traite_le: $now.setZone('Europe/Paris').toFormat('yyyy-LL-dd HH:mm')\n} };",
        "language": "javaScript",
        "mode": "runOnceForEachItem"
      },
