      "name": "Formater resultats",
      "parameters": {
        "jsCode": "const r = $input.first().json || {};\nconst items = ((r.ok && r.data && r.data.items) || []).filter(c => c.category !== 'supplier');\nif (!items.length) return [{ json: { resultat: 'Aucun client trouve pour ce nom.' } }];\nconst L = items.slice(0, 10).map(c => {\n  const a = c.address || {};\n  return [c.name ? String(c.name).trim() : '?', 'client_id: ' + c.id, [a.address, [a.zipCode, a.city].filter(Boolean).join(' ')].filter(Boolean).join(', '), c.phoneNumber ? 'tel ' + c.phoneNumber : '', c.secondaryPhoneNumber ? 'tel2 ' + c.secondaryPhoneNumber : ''].filter(Boolean).join(' | ');\n});\nreturn [{ json: { resultat: 'Clients trouves (recherche approximative, verifier le nom) :\\n' + L.join('\\n') } }];",
