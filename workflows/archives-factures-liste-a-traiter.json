    {
      "id": "9366fb9e-472c-4b25-b99e-8c4778868cb9",
      "name": "Preparer liste",
      "parameters": {
        "jsCode": "const ROOT = '18foeaN7yoGBfRc9USHJcp1ULzHUBIlgK';\nconst PREMIER_INTERFAST = 14146;\nconst dossiers = {};\nfor (const page of $('Lister dossiers').all()) for (const f of (page.json.files || [])) dossiers[f.id] = f;\nconst fichiers = [];\nfor (const page of $('Lister factures').all()) for (const f of (page.json.files || [])) fichiers.push(f);\nconst dejaFaits = new Set($('Lire index').all().map(i => String(i.json.numero || '').trim()).filter(Boolean));\nfunction dossierClient(f) {\n  let p = (f.parents || [])[0];\n  let dernier = null;\n  let garde = 0;\n  while (p && p !== ROOT && garde < 25) {\n    dernier = dossiers[p];\n    if (!dernier) return null;\n    p = (dernier.parents || [])[0];\n    garde++;\n  }\n  if (p !== ROOT) return null;\n  return dernier ? dernier.name : '(racine)';\n}\nconst meilleurs = {};\nfor (const f of fichiers) {\n  const m = String(f.name).match(/^\\s*(FA|AV)[\\s\\-_]*(\\d{2,6})/i);\n  if (!m) continue;\n  const genre = m[1].toUpperCase();\n  const n = parseInt(m[2], 10);\n  if (genre === 'FA' && n >= PREMIER_INTERFAST) continue;\n  const dc = dossierClient(f);\n  if (dc === null) continue;\n  const numero = genre + m[2];\n  const score = (/PAYEE/i.test(f.name) ? 0 : 1) * 1000 + String(f.name).length;\n  const actuel = meilleurs[numero];\n  if (!actuel || score < actuel.score) meilleurs[numero] = { numero, genre, n, score, file_id: f.id, nom_fichier: f.name, dossier_client: dc, lien_pdf: f.webViewLink || ('https://drive.google.com/file/d/' + f.id + '/view') };\n}\nconst aFaire = Object.values(meilleurs).filter(x => !dejaFaits.has(x.numero)).sort((a, b) => (a.genre === b.genre ? a.n - b.n : (a.genre === 'FA' ? -1 : 1)));\nreturn aFaire.map(x => ({ json: { numero: x.numero, file_id: x.file_id, nom_fichier: x.nom_fichier, dossier_client: x.dossier_client, lien_pdf: x.lien_pdf } }));",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      },
      "position": [
        1100,
        300
      ],
