        "jsCode": "const i = $input.first().json;\nconst ref = String(i.ref_devis || '').trim().toUpperCase();\nif (/^[A-Z]{1,3}[0-9]{2,6}$/.test(ref)) return [{ json: { op: 'devis_par_ref', params: { ref }, ref } }];\nconst cid = String(i.client_id || '').trim();\nreturn [{ json: { op: 'devis_client_signes', params: { clientId: cid || 'aucun' }, ref: '' } }];",
