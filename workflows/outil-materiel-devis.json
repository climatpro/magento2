    {
      "id": "ff6eb74e-921d-4587-b944-66ac7b08ae61",
      "name": "Choisir devis",
      "parameters": {
        "jsCode": "const req = $('Preparer requete').first().json;\nconst r = $input.first().json || {};\nlet list = (r.ok && r.data && r.data.items) || [];\nif (req.ref) list = list.filter(d => String(d.reference || '').toUpperCase() === req.ref);\nelse list = list.filter(d => d.signedAt).sort((a, b) => String(b.signedAt).localeCompare(String(a.signedAt)));\nconst ids = list.slice(0, 3).map(d => String(d.id));\nreturn (ids.length ? ids : ['aucun']).map(id => ({ json: { id } }));",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      },
      "position": [
        672,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "fc9d7256-0dcf-4ece-be8c-2ca179357d7b",
      "name": "Formater materiel",
      "parameters": {
        "jsCode": "const out = [];\nfunction lignes(items, acc) {\n  for (const x of (items || [])) {\n    if (x.type === 'section') { if (x.name) acc.push('  [' + String(x.name).replace(/\\s+/g, ' ').slice(0, 80) + ']'); lignes(x.items, acc); continue; }\n    const nom = String(x.name || '').replace(/\\s+/g, ' ').trim();\n    if (!nom) continue;\n    acc.push('  - ' + (x.quantity == null ? 1 : x.quantity) + ' ' + (x.unit || '') + ' : ' + nom.slice(0, 250) + (x.isOption ? ' (option)' : ''));\n  }\n  return acc;\n}\nfor (const it of $input.all()) {\n  const r = it.json || {};\n  if (!r.ok || !r.data || !r.data.id) continue;\n  const d = r.data;\n  const signe = d.signedAt ? ' signe le ' + DateTime.fromISO(d.signedAt).setZone('Europe/Paris').toFormat('dd/MM/yyyy') : '';\n  out.push('Devis ' + (d.reference || '?') + ' (' + (d.status || '?') + signe + ') : ' + String(d.name || '').replace(/\\s+/g, ' ').slice(0, 120));\n  out.push(...lignes(d.items, []).slice(0, 40));\n}\nreturn [{ json: { resultat: out.length ? out.join('\\n') : 'Aucun devis signe trouve.' } }];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      },
      "position": [
        1120,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
